# Copy to .env locally. Never commit real secrets.
NODE_ENV=development
PORT=8787
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
# Generate a long random secret locally. This prototype uses one owner bearer token.
NOVA_OWNER_TOKEN=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Checkout intentionally remains disabled. No payment integration is configured.
CHECKOUT_ENABLED=false
